# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_KEY=

# Local demo data (demo catalog connector). Leave unset in production.
IMAGINE_DEMO=1

# Comma-separated emails that become super admins (platform console) when they sign in.
SUPER_ADMIN_EMAILS=

# Password of the seeded local account demo@imagine.local (IMAGINE_DEMO=1 only). Default: imagine-demo
IMAGINE_DEMO_PASSWORD=

# Postgres. Locally: brew install postgresql@17 && createdb imagine. Railway: reference the Postgres service.
# Then: npm run db:migrate (and once, npm run db:import-dev-store to bring over old .data/dev-store.json).
DATABASE_URL=postgres://localhost:5432/imagine
DATABASE_POOL_SIZE=10

# Asset storage. Leave S3_BUCKET unset to store files under .data/assets (development only).
# Railway Bucket / Cloudflare R2 / AWS S3 (private bucket). S3_FORCE_PATH_STYLE=1 for MinIO.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# Sign-in. With both Clerk keys set, Clerk owns sign-in/up, email verification, password reset, MFA and
# sessions (needed at build time too: pages read them when prerendering). Leave both empty for the local
# password login. In the Clerk dashboard: email + password sign-in, and set the app's domain for invitations.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk webhook (endpoint /api/clerk/webhook, event user.updated): keeps names/emails in step with Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=
# Base URL used in invitation emails (e.g. https://app.imagine.ai). Defaults to the request's host.
APP_URL=

# Transactional email (invitations, password reset for the local login, copy review notices).
# Set ONE transport: RESEND_API_KEY (Resend HTTP API) or SMTP_URL (smtps://user:pass@host:465).
# Without either, development writes emails to EMAIL_OUTBOX_DIR (default .data/outbox) and
# production sends none (the Team page says so).
EMAIL_FROM="Imagine AI <no-reply@example.com>"
RESEND_API_KEY=
SMTP_URL=
EMAIL_OUTBOX_DIR=

# Redis (Railway Redis service; locally: brew services start redis). Shared rate limits, job queue and the
# worker (`npm run worker`, Railway "worker" service). Without it, rate limits are per process and there is no worker.
REDIS_URL=redis://localhost:6379
# Bulk Copy products the worker writes at once (default 3).
# COPY_BATCH_CONCURRENCY=3
# Bulk image products the worker makes at once (default 2; image calls are slow and memory-heavy).
# IMAGE_BATCH_CONCURRENCY=2
# Video editor exports the worker renders at once (default 1; FFmpeg uses the whole CPU).
# VIDEO_EDIT_CONCURRENCY=1
# ffmpeg for the video editor: defaults to the binary `ffmpeg-static` downloads at npm install; set to use a system ffmpeg.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Stripe billing (leave STRIPE_SECRET_KEY empty to manage plans only from the super-admin console).
# Prices live in Stripe (AED, monthly + yearly): `npm run stripe:setup -- --starter-monthly … --pro-yearly …`
# prints the price ids. Webhook endpoint: /api/stripe/webhook (locally: stripe listen --forward-to localhost:3004/api/stripe/webhook).
# Enable the Customer Portal in the Stripe dashboard (payment method + invoices).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Free trial on an org's first subscription, in days (0 = no trial).
STRIPE_TRIAL_DAYS=14

# Sentry error tracking (one project for web + worker). Empty = off. Events are scrubbed of keys, tokens,
# cookies and request bodies; users appear by id only. SENTRY_AUTH_TOKEN/ORG/PROJECT upload source maps at build.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
